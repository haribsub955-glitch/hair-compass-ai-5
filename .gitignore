# Personal/local editor settings (not for the team)
.claude/settings.local.json

# npm install output for the shadcn CLI in package.json — restorable from package-lock.json,
# and nothing in the iOS app links against it.
node_modules/

# Secrets. Never committed — the server access key and any provider key live here or in the
# scheme's run environment, and both are handed over privately.
.env
.env.*
*.xcconfig
Secrets.swift
**/Secrets/
*.p12
*.mobileprovision
