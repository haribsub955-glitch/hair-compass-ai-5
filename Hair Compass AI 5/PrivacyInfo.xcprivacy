<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No tracking, no ad networks, no data broker. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  The app collects NO data off-device. All AI runs on-device (Apple Intelligence / Vision),
	  every record and photo stays in on-device storage, and there is no server or analytics
	  upload. So no data types are declared here.
	  NOTE: this must match the "App Privacy" answers in App Store Connect — set "Data Not
	  Collected" there to reconcile before submitting.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!--
	  Required-reason API declarations — this is the part App Review scans the binary against.
	  App Group UserDefaults (app + widget), plus backup-file attributes read only to show size.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
